{
  "name": "localharness",
  "version": "0.1.0",
  "description": "A local-first AI harness for the Mac Studio inference server — workflow profiles, MCP orchestration, and live inference telemetry.",
  "main": "./out/main/index.js",
  "author": "Adam",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:sandbox": "node scripts/sandbox-test.mjs",
    "test:calibration": "node scripts/calibration-test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:activity": "node scripts/activity-test.mjs",
    "test": "npm run typecheck && npm run test:sandbox && npm run test:calibration && npm run test:activity",
    "verify": "npm run test && npm run test:smoke",
    "package": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.adam.localharness",
    "productName": "LocalHarness",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
